# Copy to .env for local development. Never commit real values.
# Every provider is optional: without a key, its signals are reported as "not configured". Nothing is simulated.

NODE_ENV=development
PORT=8787

# ── Required in production ────────────────────────────────────────────
# At least 32 random characters:  openssl rand -base64 48
SESSION_SECRET=
# Separate key for hashing addresses and fingerprints. Defaults to a value derived from SESSION_SECRET.
IP_HASH_SECRET=
DATABASE_URL=postgres://portfolio:portfolio@localhost:54329/portfolio

# ── Where the client's address comes from ─────────────────────────────
# socket          no proxy in front (local development)
# x-real-ip       Railway's edge sets this header (production default)
# x-forwarded-for behind other proxies; set TRUSTED_PROXY_HOPS to how many you trust
CLIENT_IP_SOURCE=socket
TRUSTED_PROXY_HOPS=1
# Canonical origin, e.g. https://markgraziano.com. Used to reject cross-site POSTs.
PUBLIC_ORIGIN=

# ── Providers ─────────────────────────────────────────────────────────
# Cloudflare Turnstile (free). Both or neither.  https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: reject tokens issued for any other hostname.
TURNSTILE_HOSTNAME=

# ipapi.is (free: 1,000/day). Organisation, network type, location, VPN/proxy flags.  https://ipapi.is
IPAPI_IS_KEY=

# IPinfo (Lite is free and unlimited). Second opinion on network operator and country.  https://ipinfo.io
IPINFO_TOKEN=
IPINFO_PLAN=lite

# AbuseIPDB (free: 1,000 checks/day). Optional.  https://www.abuseipdb.com
ABUSEIPDB_API_KEY=

# Ceiling on live calls to each metered provider per UTC day.
PROVIDER_DAILY_LIMIT=900
PROVIDER_TIMEOUT_MS=2500

# ── Sessions and retention ────────────────────────────────────────────
SESSION_TTL_MINUTES=480
RETENTION_DAYS=30

# ── Admin ─────────────────────────────────────────────────────────────
# Generate with:  npm run build && npm run admin:hash
# Leave empty to disable the admin interface entirely.
ADMIN_PASSWORD_HASH=
