{
  "name": "@portfolio/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "esbuild src/server.ts src/migrate.ts src/hash-password.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@portfolio/contracts=../../packages/contracts/src/index.ts --alias:@portfolio/policy=../../packages/policy/src/index.ts --outdir=dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@portfolio/contracts": "*",
    "@portfolio/policy": "*",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
